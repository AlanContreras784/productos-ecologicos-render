# ===============================================================
# VARIABLES DE ENTORNO - EJEMPLO
# ===============================================================


# ===============================================================
# JWT
# ===============================================================

# Clave Base64 utilizada para firmar los tokens JWT.
JWT_SECRET=


# ===============================================================
# BASE DE DATOS MYSQL
# ===============================================================

# URL de conexión a MySQL.
DB_URL=

# Usuario de MySQL.
DB_USERNAME=

# Contraseña de MySQL.
DB_PASSWORD=


# ===============================================================
# RESEND
# ===============================================================

# API Key utilizada para enviar emails mediante Resend.
RESEND_API_KEY=

# Correo administrativo que recibe las notificaciones
# de nuevos registros.
RESEND_ADMIN_EMAIL=


# ===============================================================
# GOOGLE OAUTH2
# ===============================================================

# Client ID de Google.
GOOGLE_CLIENT_ID=

# Client Secret de Google.
GOOGLE_CLIENT_SECRET=


# ===============================================================
# URLS DE LA APLICACIÓN
# ===============================================================

# URL pública del backend.
# Se utiliza para construir enlaces y referencias
# relacionadas con el backend de la aplicación.
APP_BASE_URL=

# URL pública del frontend.
# Se utiliza para redirigir al usuario después
# de confirmar correctamente su dirección de email.
FRONTEND_URL=